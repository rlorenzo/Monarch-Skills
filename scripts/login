#!/usr/bin/env python3
"""One-time Monarch Money login.

Runs upstream's login_setup.py at whatever commit .mcp.json pins, with the same
dependency bounds, so the pin lives in exactly one place. The session is saved to
your OS keyring; nothing is written to this repo.
"""

import json
import os
import pathlib
import sys

REPO = "robcerda/monarch-mcp-server"

args = json.loads((pathlib.Path(__file__).parent.parent / ".mcp.json").read_text())
args = args["mcpServers"]["monarch-money"]["args"]
source = args[args.index("--from") + 1]
sha = source.rpartition("@")[2]

if len(sha) != 40:
    sys.exit(f"Could not read a pinned commit from .mcp.json (got {sha!r})")

cmd = ["uv", "run"]
for i, arg in enumerate(args):
    if arg == "--with":
        cmd += ["--with", args[i + 1]]
cmd += ["--with", source]
cmd += [f"https://raw.githubusercontent.com/{REPO}/{sha}/login_setup.py"]

print(f"Logging in against {sha[:7]}\n", file=sys.stderr)
os.execvp(cmd[0], cmd)
