#!/usr/bin/env python3
"""Lint the plugin manifests and skills.

Runs Claude Code's own validator when available, then the checks it cannot know
about: that skills only reference tools this repo's read-only config actually
exposes, and that the MCP pin scripts/login depends on is still a real commit.
"""

import json
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).parent.parent

# Withheld when MONARCH_MCP_READ_ONLY is set, which .mcp.json defaults to on.
# A skill that tells Claude to call one of these fails at runtime: the tool is
# never registered, so it is not merely refused, it does not exist.
MUTATING_TOOLS = {
    "create_transaction", "update_transaction", "delete_transaction",
    "categorize_transaction", "update_transaction_notes",
    "mark_transaction_reviewed", "bulk_categorize_transactions",
    "split_transaction", "upload_account_balance_history",
    "set_transaction_tags", "add_transaction_tag", "create_transaction_tag",
    "create_transaction_rule", "update_transaction_rule",
    "delete_transaction_rule", "reorder_transaction_rule",
    "create_transaction_category", "update_category", "set_budget_amount",
    "update_savings_goal", "set_goal_contribution", "update_merchant",
    "review_recurring_stream", "monarch_login", "monarch_login_with_token",
    "monarch_logout", "update_account", "refresh_accounts",
}

# Sorted once so the reported tool is deterministic when a line names two.
SORTED_MUTATING_TOOLS = sorted(MUTATING_TOOLS)

errors = []


def check_skills():
    skills = sorted((ROOT / "skills").glob("*/SKILL.md"))
    if not skills:
        errors.append("no skills found under skills/")
    for skill in skills:
        rel = skill.relative_to(ROOT)
        text = skill.read_text()
        front = re.match(r"^---\n(.*?)\n---\n", text, re.S)
        if not front:
            errors.append(f"{rel}: missing YAML frontmatter")
            continue
        fields = dict(
            re.findall(
                r"^(name|description|license|allowed-tools):\s*(.+)$",
                front.group(1), re.M,
            )
        )
        if not skill.parent.name.startswith("monarch-"):
            errors.append(
                f"{rel}: skill directories are prefixed monarch- so they group "
                f"together in the skills list"
            )
        if not fields.get("license"):
            errors.append(f"{rel}: no license in frontmatter")
        # allowed-tools pre-approves, it does not restrict. Listing a write tool
        # here would silently skip the prompt for a mutation if someone runs
        # with MONARCH_MCP_READ_ONLY off.
        for tool in fields.get("allowed-tools", "").replace(",", " ").split():
            if tool.rpartition("__")[2] in MUTATING_TOOLS:
                errors.append(f"{rel}: allowed-tools pre-approves write tool {tool}")
        if fields.get("name") != skill.parent.name:
            errors.append(
                f"{rel}: frontmatter name {fields.get('name')!r} "
                f"!= directory {skill.parent.name!r}"
            )
        if not fields.get("description"):
            errors.append(f"{rel}: no description, so it will never be matched")
        check_write_tool_placement(rel, text[front.end():])
    return len(skills)


def check_write_tool_placement(rel, body):
    """Write tools may only be named under `## Apply` (see MUTATING_TOOLS for why).

    Confining them to one section keeps the read path runnable as written, and
    keeps the write path in a block that says what it costs. The heading must be
    exactly `## Apply`: matching a prefix would let a `## Applying ...` step in
    the read path exempt itself from the check.
    """
    section = None
    fence = ""  # the opening fence marker, "" outside a fence
    for line in body.splitlines():
        # Up to three spaces, per CommonMark. Accepting any indent read a fence
        # marker inside an indented code block as a real opener, which wedged
        # the fence open and carried an '## Apply' past the headings after it.
        run = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", line)
        if run:
            marker, rest = run.group(1), run.group(2)
            # CommonMark: only a run of the same character, at least as long as
            # the opener and alone on its line, closes. Toggling on any ``` lets
            # a ```python line inside a ```` block wedge the fence open, and the
            # headings after it then get read as fenced examples.
            if fence:
                if marker[0] == fence[0] and len(marker) >= len(fence) and not rest.strip():
                    fence = ""
                continue
            # A backtick opener's info string cannot contain a backtick, so an
            # inline span like ```VAR=0``` opens nothing. Treating it as a fence
            # swallowed every heading after it, and the section in force stayed
            # whatever it was — an '## Apply' before it exempted the whole file.
            if marker[0] != "`" or "`" not in rest:
                fence = marker
                continue
        # A fenced `## Apply` is an example, not a section, and must not gate.
        heading = None if fence else re.match(r"^##\s+(.+?)\s*$", line)
        if heading:
            section = heading.group(1)
            continue
        if (section or "").strip().lower() == "apply":
            continue
        for tool in SORTED_MUTATING_TOOLS:
            # Prose naming a tool only to say it is unavailable is fine anywhere.
            if tool in line and "withhold" not in line and "cannot" not in line:
                errors.append(
                    f"{rel}: names write tool {tool} outside an '## Apply' section "
                    f"(in {section or 'the preamble'!r})"
                )
                break


def check_write_tool_placement_self_test():
    """The placement rule is the one check here with real branching, so pin it."""
    cases = {
        "## Gather\ncall update_transaction\n": True,
        "## Apply\ncall update_transaction\n": False,
        # A prefix match would let a read-path step exempt itself.
        "## Applying the rules\ncall update_transaction\n": True,
        # A fenced heading is an example, not a section.
        "## Gather\n```\n## Apply\n```\ncall update_transaction\n": True,
        # A shorter run inside a longer fence does not close it, so the real
        # heading after the block still counts.
        "## Apply\n````\n```\n````\n## Gather\ncall update_transaction\n": True,
        "~~~\n## Apply\n~~~\ncall update_transaction\n": True,
        # An inline code span is not a fence opener, so the Gather heading after
        # it still ends the Apply exemption.
        "## Apply\n```VAR=0```\n\n## Gather\ncall update_transaction\n": True,
        # A fence marker indented four spaces is code, not an opener, so the
        # Gather heading after it still ends the Apply exemption.
        "## Apply\n\n    ```python\n    example\n\n## Gather\ncall update_transaction\n": True,
        # Three spaces still opens a fence, so this Gather is an example.
        "## Apply\n   ```\n   ## Gather\n   ```\ncall update_transaction\n": False,
        # Prose naming a tool only to say it is unavailable is fine anywhere.
        "## Gather\nYou cannot call update_transaction here.\n": False,
    }
    for body, want in cases.items():
        before = len(errors)
        check_write_tool_placement("<self-test>", body)
        got = len(errors) > before
        del errors[before:]
        if got != want:
            errors.append(
                f"scripts/lint: write-tool placement self-test failed for "
                f"{body!r} (flagged={got}, expected={want})"
            )


def check_pin():
    mcp = json.loads((ROOT / ".mcp.json").read_text())
    args = mcp["mcpServers"]["monarch-money"]["args"]
    source = args[args.index("--from") + 1]
    sha = source.rpartition("@")[2]
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        errors.append(f".mcp.json: server is not pinned to a full commit sha ({sha!r})")
    if not any(a.startswith("mcp[cli]") for a in args):
        errors.append(".mcp.json: no upper bound on mcp; a new major will break the pin")


def run_validator():
    if not shutil.which("claude"):
        print("claude CLI not found, skipping manifest validation")
        return
    for target in (".", "skills"):
        result = subprocess.run(
            ["claude", "plugin", "validate", target],
            cwd=ROOT, capture_output=True, text=True,
        )
        print(result.stdout.strip() or result.stderr.strip())
        if result.returncode != 0:
            errors.append(f"claude plugin validate {target} failed")


run_validator()
check_write_tool_placement_self_test()
count = check_skills()
check_pin()

if errors:
    print(f"\n{len(errors)} problem(s):")
    for e in errors:
        print(f"  - {e}")
    sys.exit(1)
print(f"\nok: {count} skills, manifests and pin look right")
