{
  "mcpServers": {
    "monarch-money": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with", "mcp[cli]<3",
        "--with", "monarchmoneycommunity==1.7.1",
        "--from", "git+https://github.com/robcerda/monarch-mcp-server@60051e35c9e8e86147575db1d2bdc157291d925b",
        "monarch-mcp-server"
      ],
      "env": {
        "MONARCH_MCP_READ_ONLY": "${MONARCH_MCP_READ_ONLY:-1}"
      }
    }
  }
}
